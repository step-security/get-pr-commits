{
  "name": "@step-security/get-pr-commits",
  "version": "1.3.1",
  "description": "Reads the commits of the pull request a workflow is running on.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "ncc build src/index.ts -o dist --minify --license licenses.txt",
    "all": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/get-pr-commits.git"
  },
  "keywords": [
    "actions",
    "github",
    "pull-request",
    "commits"
  ],
  "author": "step-security",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/step-security/get-pr-commits/issues"
  },
  "homepage": "https://github.com/step-security/get-pr-commits#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vercel/ncc": "0.45.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  }
}
